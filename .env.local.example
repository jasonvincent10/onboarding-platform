# ─────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# Set the same variables in the Vercel project for preview/production.
# ─────────────────────────────────────────────────────────────────

# Public origin — used for metadataBase, canonical URLs, robots.txt and
# sitemap.xml. Set to the live domain in Vercel; localhost for local dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_<your-key>

# The "from" address for contact-form email. Must be on a domain verified in
# Resend (mail.vopria.com is already verified — see DOMAIN.md).
# Optional: defaults to "Vopria <website@mail.vopria.com>" if unset.
RESEND_FROM_EMAIL=Vopria <website@mail.vopria.com>

# Where contact-form enquiries are delivered.
# Optional: defaults to jason@vopria.com if unset.
CONTACT_INBOX=jason@vopria.com

# Booking link for every "Book a call" button. While this is unset, those
# buttons fall back to /contact and the booking panel on the contact page
# hides itself, so nothing links to a dead URL.
CALENDLY_URL=
